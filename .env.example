PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/sigil
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
PUBLIC_BASE_URL=https://sigil.adnand.com
CORS_ORIGIN=https://sigil.adnand.com
# Calls: must match static-auth-secret in deploy/turnserver.conf
TURN_SECRET=change_me_turn_secret
TURN_URLS=turn:sigil.adnand.com:3478?transport=udp,turns:sigil.adnand.com:5349?transport=tcp
STUN_URLS=stun:sigil.adnand.com:3478
# Push notifications for incoming calls. Path to your Firebase service-account JSON (keep it private).
FIREBASE_SERVICE_ACCOUNT=/opt/sigil-server/secrets/firebase-service-account.json
CF_TURN_KEY_ID=4ac15b87f7caa248b914d44346357638
CF_TURN_API_TOKEN=c914264f6f2a18eec327abfbc5bcf4ee1d58b69e169a6587282ee3c2105e912a