PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/sigil
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
PUBLIC_BASE_URL=https://sigil.adnand.com
CORS_ORIGIN=https://sigil.adnand.com
CF_TURN_API_TOKEN=
CF_TURN_KEY_ID=
# Push notifications for incoming calls. Path to your Firebase service-account JSON (keep it private).
FIREBASE_SERVICE_ACCOUNT=/opt/sigil-server/secrets/firebase-service-account.json
